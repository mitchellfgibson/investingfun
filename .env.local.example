# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and will NEVER be committed.

# --- Market data (fundamentals + prices) ---
# Free key from https://site.financialmodelingprep.com/developer/docs  (250 req/day)
FMP_API_KEY=

# Optional: override FMP base URL (rarely needed)
# FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# --- Claude API (OPTIONAL) ---
# If set, the social-buzz agent uses Claude (Haiku) for a richer summary.
# If empty, it falls back to free rule-based sentiment. Pay-per-token billing.
ANTHROPIC_API_KEY=

# --- Google Sheets DCF export (OPTIONAL — see GOOGLE_SHEETS_SETUP.md) ---
# Path to your service-account JSON key (kept OUTSIDE the repo):
# GOOGLE_SERVICE_ACCOUNT_FILE=/Users/you/.config/investingfun/google-service-account.json
# ...or paste the whole JSON on one line instead:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Auto-share created sheets to your Google account:
# GOOGLE_SHARE_WITH_EMAIL=
# Optional Drive folder to place sheets in (share it with the service account):
# GOOGLE_DRIVE_FOLDER_ID=
